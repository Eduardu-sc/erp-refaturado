{
  "name": "erp-refaturado",
  "version": "0.5.4",
  "description": "",
  "main": "src/main.js",
  "scripts": {
    "build": "tsup --tsconfig tsconfig.build.json src/main.ts",
    "start": "node dist/main.cjs",
    "dev": "tsx watch --env-file .env.dev  src/main.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest  --passWithNoTests",
    "prepare": "husky",
    "lint:fix": "eslint src/*.ts --fix",
    "db:migrate": "node --env-file=.env.dev ./node_modules/knex/bin/cli.js migrate:latest",
    "db:rollback": "node --env-file=.env.dev ./node_modules/knex/bin/cli.js migrate:rollback",
    "docker:up": "docker compose up -d"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@rocketseat/eslint-config": "^2.2.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/sinon": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "axios": "^1.19.0",
    "eslint": "^8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "git-commit-msg-linter": "^5.0.9",
    "husky": "^9.1.7",
    "knex": "^3.3.0",
    "lint-staged": "^17.3.0",
    "mysql2": "^3.23.3",
    "sinon": "^22.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "5.8.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.ts": [
      "npm run lint:fix"
    ]
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1"
  }
}
